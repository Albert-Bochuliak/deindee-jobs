# Copy to .env and fill in what you need. All values have safe defaults.

DB_PATH=jobs.db
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) JobScraper/1.0
RATE_LIMIT_SECONDS=2
REQUEST_TIMEOUT=30

# Optional API sources (source is enabled only if key is set)
JOOBLE_API_KEY=

# Adzuna: register free at https://developer.adzuna.com/ — both needed to enable
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# USAJOBS: request a free key at https://developer.usajobs.gov — both needed to enable
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Admin panel at /admin — login is disabled until ADMIN_PASSWORD is set
ADMIN_USER=admin
ADMIN_PASSWORD=

# Djinni HTML scraping (no API) — URL template, {kw} = keywords
DJINNI_JOBS_URL=https://djinni.co/jobs/?keywords={kw}

# RSS feed URL templates, {kw} is replaced by the search query
DOU_FEED_URL=https://jobs.dou.ua/vacancies/feeds/?search={kw}
WORKUA_FEED_URL=https://www.work.ua/jobs-{kw}/?rss=1
